@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

set(WUWE_PACKAGE_HTTP_BACKEND "@WUWE_HTTP_BACKEND_NORMALIZED@")
set(WUWE_PACKAGE_TLS_BACKEND "@WUWE_TLS_BACKEND_RESOLVED@")
set(WUWE_PACKAGE_WITH_OPENSSL @WUWE_BUILT_WITH_OPENSSL@)
set(WUWE_PACKAGE_WITH_HTTPLIB_HTTPS @WUWE_BUILT_WITH_HTTPLIB_HTTPS@)
set(WUWE_PACKAGE_WITH_SQLITE @WUWE_BUILT_WITH_SQLITE@)
set(WUWE_PACKAGE_SQLITE_DEPENDENCY "@WUWE_SQLITE_DEPENDENCY@")
set(WUWE_PACKAGE_SQLITE_CMAKE_TARGET "@WUWE_SQLITE_CMAKE_TARGET@")

if(WUWE_PACKAGE_WITH_OPENSSL AND NOT TARGET OpenSSL::SSL)
    find_dependency(OpenSSL REQUIRED)
endif()

if(WUWE_PACKAGE_WITH_SQLITE)
    if(WUWE_PACKAGE_SQLITE_DEPENDENCY STREQUAL "cmake" AND
       NOT TARGET "${WUWE_PACKAGE_SQLITE_CMAKE_TARGET}")
        find_dependency(SQLite3 REQUIRED)
    elseif(WUWE_PACKAGE_SQLITE_DEPENDENCY STREQUAL "unofficial" AND
           NOT TARGET unofficial::sqlite3::sqlite3)
        find_dependency(unofficial-sqlite3 CONFIG REQUIRED)
    endif()
endif()

set(WUWE_DEPENDENCY_CMAKE_DIR "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@/cmake")
set(WUWE_USING_BUNDLED_CURL OFF)

if(NOT TARGET CURL::libcurl_static AND NOT TARGET CURL::libcurl)
    if(EXISTS "${WUWE_DEPENDENCY_CMAKE_DIR}/CURL/CURLConfig.cmake")
        include("${WUWE_DEPENDENCY_CMAKE_DIR}/CURL/CURLConfig.cmake")
        set(WUWE_USING_BUNDLED_CURL ON)
    else()
        find_dependency(CURL REQUIRED)
    endif()
endif()

# The packaged static curl must keep using the zlib archive it was built with.
# Do not let an unrelated consumer dependency with the generic ZLIB::ZLIB name
# silently change that link contract.
if(WUWE_USING_BUNDLED_CURL)
    find_library(WUWE_BUNDLED_ZLIB_LIBRARY_RELEASE
        NAMES zlibstatic zlibstat zlib z
        PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@"
        NO_DEFAULT_PATH)
    find_library(WUWE_BUNDLED_ZLIB_LIBRARY_DEBUG
        NAMES zlibstaticd zlibstatd zlibd zd
        PATHS "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_LIBDIR@"
        NO_DEFAULT_PATH)
    if(NOT WUWE_BUNDLED_ZLIB_LIBRARY_RELEASE AND NOT WUWE_BUNDLED_ZLIB_LIBRARY_DEBUG)
        set(wuwe_FOUND FALSE)
        set(wuwe_NOT_FOUND_MESSAGE "The bundled zlib archive is missing from the Wuwe installation")
        return()
    endif()
    if(NOT TARGET wuwe::bundled_zlib)
        add_library(wuwe::bundled_zlib STATIC IMPORTED)
        set_target_properties(wuwe::bundled_zlib PROPERTIES
            INTERFACE_INCLUDE_DIRECTORIES "${PACKAGE_PREFIX_DIR}/@CMAKE_INSTALL_INCLUDEDIR@")
        # Publish each installed configuration independently, including Debug-only
        # packages. CMake can fall back to the available archive in single-config
        # packages, while combined installations retain the matching CRT.
        foreach(WUWE_ZLIB_CONFIG RELEASE DEBUG)
            if(WUWE_BUNDLED_ZLIB_LIBRARY_${WUWE_ZLIB_CONFIG})
                set_property(TARGET wuwe::bundled_zlib APPEND PROPERTY
                    IMPORTED_CONFIGURATIONS "${WUWE_ZLIB_CONFIG}")
                set_target_properties(wuwe::bundled_zlib PROPERTIES
                    IMPORTED_LOCATION_${WUWE_ZLIB_CONFIG}
                        "${WUWE_BUNDLED_ZLIB_LIBRARY_${WUWE_ZLIB_CONFIG}}")
            endif()
        endforeach()
    endif()
    foreach(WUWE_CURL_TARGET CURL::libcurl_static CURL::libcurl)
        if(TARGET "${WUWE_CURL_TARGET}")
            get_target_property(WUWE_CURL_ALIASED_TARGET
                "${WUWE_CURL_TARGET}" ALIASED_TARGET)
            if(WUWE_CURL_ALIASED_TARGET)
                set(WUWE_CURL_MUTABLE_TARGET "${WUWE_CURL_ALIASED_TARGET}")
            else()
                set(WUWE_CURL_MUTABLE_TARGET "${WUWE_CURL_TARGET}")
            endif()
            get_target_property(WUWE_CURL_LINK_LIBRARIES
                "${WUWE_CURL_MUTABLE_TARGET}" INTERFACE_LINK_LIBRARIES)
            if(WUWE_CURL_LINK_LIBRARIES)
                string(REPLACE "ZLIB::ZLIB" "wuwe::bundled_zlib"
                    WUWE_CURL_LINK_LIBRARIES "${WUWE_CURL_LINK_LIBRARIES}")
                set_target_properties("${WUWE_CURL_MUTABLE_TARGET}" PROPERTIES
                    INTERFACE_LINK_LIBRARIES "${WUWE_CURL_LINK_LIBRARIES}")
            endif()
        endif()
    endforeach()
endif()

if(NOT TARGET cpr::cpr)
    if(EXISTS "${WUWE_DEPENDENCY_CMAKE_DIR}/cpr/cprTargets.cmake")
        include("${WUWE_DEPENDENCY_CMAKE_DIR}/cpr/cprTargets.cmake")
    else()
        find_dependency(cpr CONFIG REQUIRED)
    endif()
endif()

set_and_check(WUWE_LIB_DIR "@PACKAGE_LIB_INSTALL_DIR@")
include("${WUWE_LIB_DIR}/cmake/wuwe-targets.cmake")

check_required_components(wuwe)
